---
/** Price block: current price gold, old price struck through, discount pill. */
import { formatPrice, discountPercent } from '../lib/format';
interface Props { price: number; oldPrice?: number; currencyLabel?: string; large?: boolean; }
const { price, oldPrice, currencyLabel = 'Rs.', large = false } = Astro.props;
const discount = discountPercent(price, oldPrice);
---
<p class="price" class:large={large}>
  <span class="current">{formatPrice(price, currencyLabel)}</span>
  {oldPrice && (
    <>
      <s class="old">{formatPrice(oldPrice, currencyLabel)}</s>
      {discount !== null && <span class="pill">-{discount}%</span>}
    </>
  )}
</p>

<style>
  .price {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    margin: 0;
    font-variant-numeric: tabular-nums;
    flex-wrap: wrap;
  }
  .current { color: var(--gold); font-weight: 700; font-size: 1rem; }
  .large .current { font-size: clamp(1.25rem, 1.1rem + 0.8vw, 1.6rem); }
  .old { color: var(--silver-muted); font-size: 0.85em; text-decoration-thickness: 1px; }
  .pill {
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--silver);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 999px;
  }
</style>
