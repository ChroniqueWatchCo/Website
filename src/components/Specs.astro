---
/** Key specs table (Section 9.1.10). Wrapped for horizontal scroll safety. */
import type { Spec } from '../lib/types';
interface Props { specs: Spec[]; movement?: string; condition?: string; }
const { specs, movement, condition } = Astro.props;
const rows = [...specs];
if (movement && !rows.some((r) => r.label.toLowerCase() === 'movement')) {
  rows.unshift({ label: 'Movement', value: movement });
}
if (condition === 'pre-owned' && !rows.some((r) => r.label.toLowerCase() === 'condition')) {
  rows.unshift({ label: 'Condition', value: 'Pre-owned' });
}
---
{rows.length > 0 && (
  <div class="scroll-x">
    <table class="specs">
      <caption class="sr-only">Key specifications</caption>
      <tbody>
        {rows.map((s) => (
          <tr><th scope="row">{s.label}</th><td>{s.value}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
)}

<style>
  .specs { font-size: 0.92rem; min-width: 260px; }
  .specs th {
    text-align: left;
    color: var(--silver-muted);
    font-weight: 500;
    padding: var(--s-2) var(--s-3) var(--s-2) 0;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  .specs td {
    padding: var(--s-2) 0;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }
  .specs tr:last-child th, .specs tr:last-child td { border-bottom: 0; }
</style>
