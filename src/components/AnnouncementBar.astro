---
/** Announcement bar (Section 8.2): single line from Site Settings, hidden if empty. */
interface Props { text?: string; }
const { text } = Astro.props;
---
{text && text.trim() !== '' && (
  <div class="announce">
    <div class="container"><p>{text}</p></div>
  </div>
)}

<style>
  .announce {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--silver);
  }
  .announce p { margin: 0; padding: var(--s-2) 0; text-align: center; }
</style>
