---
/**
 * Header (Section 8.3). Mobile menu: CSS-only <details> pattern, zero JS.
 * WhatsApp quick-contact link uses the number from Site Settings only.
 * Logo: uses /logo.svg from the repo root's public/ folder when present
 * (added by the owner); otherwise falls back to a text wordmark.
 */
import type { SiteSettings } from '../lib/types';
import { buildGenericWhatsAppLink } from '../lib/whatsapp';
import { existsSync } from 'node:fs';

interface Props { settings: SiteSettings; }
const { settings } = Astro.props;
const waLink = buildGenericWhatsAppLink(settings.whatsappNumber, settings.storeName);

// The logo file is optional: place your logo at public/logo.svg (or change the
// path below) and it will appear in the header + footer automatically.
const LOGO_SRC = '/logo.svg';
const hasLogoFile = existsSync(new URL(`../../public${LOGO_SRC}`, import.meta.url));
---
<header class="site-header">
  <div class="container header__row">
    <a href="/" class="logo" data-astro-prefetch="tap" aria-label={`${settings.storeName} — home`}>
      {hasLogoFile ? (
        <img src={LOGO_SRC} alt={settings.storeName} width="120" height="40" class="logo__img" loading="eager" decoding="async" />
      ) : (
        <span>{settings.storeName}</span>
      )}
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <a href="/original/" data-astro-prefetch="tap">Original</a>
      <a href="/replica/" data-astro-prefetch="tap">Replica</a>
      <a href="/contact/" data-astro-prefetch="tap">Contact</a>
    </nav>

    <div class="header__right">
      <a class="wa" href={waLink} rel="noopener noreferrer" aria-label="Chat on WhatsApp">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1 0 12 2zm0 2a8 8 0 1 1-4.2 14.8l-.4-.3-2.9.8.8-2.8-.2-.4A8 8 0 0 1 12 4z"/></svg>
      </a>

      <details class="menu">
        <summary aria-label="Open menu">
          <span class="menu__icon" aria-hidden="true"></span>
        </summary>
        <nav class="menu__panel" aria-label="Mobile">
          <a href="/original/" data-astro-prefetch="tap">Original</a>
          <a href="/replica/" data-astro-prefetch="tap">Replica</a>
          <a href="/contact/" data-astro-prefetch="tap">Contact</a>
          <a href={waLink} rel="noopener noreferrer">Chat on WhatsApp</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  /* Sticky allowed on desktop only, no blur (8.3) */
  @media (min-width: 768px) {
    .site-header { position: sticky; top: 0; z-index: 20; }
  }
  .header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 56px;
  }
  .logo {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    color: var(--gold);
    text-decoration: none;
    overflow-wrap: anywhere;
    max-width: 45%;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .logo__img {
    height: 40px;
    width: auto;
    max-width: 180px;
    display: block;
  }
  .nav-desktop { display: none; gap: var(--s-5); }
  .nav-desktop a {
    color: var(--silver);
    text-decoration: none;
    font-size: 0.95rem;
    padding: var(--s-3) 0; /* enlarge tap area */
  }
  .nav-desktop a:hover { color: var(--gold); }
  @media (min-width: 768px) {
    .nav-desktop { display: flex; }
    .menu { display: none !important; }
  }
  .header__right { display: flex; align-items: center; gap: var(--s-2); }
  .wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px; min-height: 44px;
    color: var(--silver);
    border-radius: var(--radius-btn);
  }
  .wa:hover { color: var(--gold); }

  /* CSS-only hamburger via <details> — full-width panel, closes on navigation
     because it is a normal page load. */
  .menu summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px; min-height: 44px;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu__icon {
    position: relative;
    display: block;
    width: 22px; height: 2px;
    background: var(--silver);
    border-radius: 2px;
  }
  .menu__icon::before, .menu__icon::after {
    content: "";
    position: absolute;
    left: 0; right: 0;
    height: 2px;
    background: var(--silver);
    border-radius: 2px;
  }
  .menu__icon::before { top: -7px; }
  .menu__icon::after { top: 7px; }
  .menu[open] .menu__icon { background: transparent; }
  .menu[open] .menu__icon::before { transform: rotate(45deg); top: 0; }
  .menu[open] .menu__icon::after { transform: rotate(-45deg); top: 0; }

  .menu__panel {
    position: absolute;
    left: 0; right: 0;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    padding: var(--s-2) var(--s-4) var(--s-4);
  }
  .menu__panel a {
    color: var(--text);
    text-decoration: none;
    padding: var(--s-3) 0;
    min-height: 44px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--border);
  }
  .menu__panel a:last-child { border-bottom: 0; }
  .menu__panel a:hover { color: var(--gold); }
  .site-header { position: relative; }
</style>
