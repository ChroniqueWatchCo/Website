---
/** Static trust strip (Section 8.4.3 / 3.3). No marquee, only owner-editable items. */
interface Props { items: string[]; }
const { items } = Astro.props;
---
{items.length > 0 && (
  <ul class="trust">
    {items.map((t) => (
      <li class="trust__item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="var(--gold)" stroke-width="2" aria-hidden="true"><path d="M2 8.5 6 12l8-9"/></svg>
        <span>{t}</span>
      </li>
    ))}
  </ul>
)}

<style>
  .trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
    padding: var(--s-3) 0;
    margin: 0;
    border-block: 1px solid var(--border);
  }
  .trust__item {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--silver);
    font-size: 0.9rem;
  }
</style>
