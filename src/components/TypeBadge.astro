---
/** Type badge (Section 2.3): Original = solid gold, Replica = silver outline. */
import type { WatchType } from '../lib/types';
interface Props { type: WatchType; size?: 'sm' | 'md'; }
const { type, size = 'sm' } = Astro.props;
---
<span class={`badge ${size === 'md' ? 'badge--md' : ''} ${type}`}>{type === 'original' ? 'ORIGINAL' : 'REPLICA'}</span>

<style>
  .badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    padding: 5px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .badge--md { font-size: 0.8rem; padding: 7px 10px; }
  .original { background: var(--gold); color: var(--on-gold); }
  .replica { background: transparent; border: 1px solid var(--silver); color: var(--silver); }
</style>
