---
/**
 * Gallery (Section 9.1.2).
 * Mobile: CSS scroll-snap swipe. Desktop: main image + thumbnail buttons.
 * JS (<=1.5 KB) only swaps the desktop main image; without JS all images are
 * visible in the scroll strip, so nothing breaks.
 */
import type { ProductImage } from '../lib/types';
import { fullImage, galleryImage } from '../lib/images';

interface Props { images: ProductImage[]; productName: string; }
const { images, productName } = Astro.props;
const main = images[0];
const mainAttrs = main ? galleryImage(main) : null;
---
{main && (
<div class="gallery" data-gallery>
  <a class="main-wrap" href={fullImage(main)} target="_blank" rel="noopener noreferrer" aria-label={`Open ${productName} full size`}>
    <img
      id="gallery-main"
      src={mainAttrs!.src}
      srcset={mainAttrs!.srcset}
      sizes={mainAttrs!.sizes}
      width={mainAttrs!.width}
      height={mainAttrs!.height}
      alt={mainAttrs!.alt}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </a>

  <ul class="strip">
    {images.map((img, i) => {
      const a = galleryImage(img);
      return (
        <li class="slide">
          <a href={fullImage(img)} target="_blank" rel="noopener noreferrer">
            <img
              src={a.src}
              srcset={a.srcset}
              sizes="(min-width:900px) 120px, 70vw"
              width={a.width}
              height={a.height}
              alt={a.alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              data-full={fullImage(img)}
              data-src={a.src}
              data-srcset={a.srcset}
            />
          </a>
          {i > 0 && (
            <button type="button" class="thumb-btn" aria-label={`Show photo ${i + 1} of ${productName}`}>
              <span class="sr-only">Show photo {i + 1}</span>
            </button>
          )}
        </li>
      );
    })}
  </ul>
  {images.length > 1 && <p class="dots muted" aria-hidden="true">{images.length} photos — swipe to see all</p>}
</div>
)}

<style>
  .gallery { display: grid; gap: var(--s-3); }
  .main-wrap {
    display: block;
    aspect-ratio: 1 / 1;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .main-wrap img { width: 100%; height: 100%; object-fit: cover; }

  /* On mobile: horizontal swipe strip with snap; main image is the first slide too,
     but we keep both: strip below acts as thumbnails on desktop and swipe on mobile. */
  .strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--s-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }
  .slide { flex: 0 0 auto; scroll-snap-align: start; position: relative; }
  .slide img {
    width: 84px; height: 84px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--border);
    display: block;
  }
  @media (max-width: 640px) {
    .strip { display: none; } /* mobile swipes the big image itself via its own snap container */
    .main-wrap {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      display: flex;
    }
    .main-wrap img { flex: 0 0 100%; scroll-snap-align: center; }
  }
  .thumb-btn {
    position: absolute;
    inset: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    min-width: 44px; min-height: 44px;
  }
  .slide:first-child .thumb-btn { display: none; }
  .dots { font-size: 0.8rem; margin: 0; }
</style>

<script>
  // Desktop thumbnail swap: <=1.5 KB vanilla JS, progressive enhancement only.
  const gallery = document.querySelector('[data-gallery]');
  if (gallery) {
    const mainImg = gallery.querySelector('#gallery-main') as HTMLImageElement | null;
    const btns = gallery.querySelectorAll<HTMLButtonElement>('.slide');
    btns.forEach((slide) => {
      const btn = slide.querySelector('button');
      const im = slide.querySelector('img');
      if (!btn || !im || !mainImg) return;
      btn.addEventListener(
        'click',
        () => {
          requestAnimationFrame(() => {
            mainImg.src = im.dataset.src ?? im.getAttribute('src') ?? '';
            if (im.dataset.srcset) mainImg.srcset = im.dataset.srcset;
            mainImg.alt = im.alt;
            const link = gallery.querySelector('.main-wrap');
            if (link) link.setAttribute('href', im.dataset.full ?? '');
          });
        },
        { passive: true }
      );
    });
  }
</script>
